{
  "name": "douyin-meta",
  "platform": "douyin",
  "category": "live_meta",
  "version": "2",
  "doc": "live room page -> room id extraction target (declarative), plus the websocket endpoint shape and the webcast message-method table consumed by internal/live. Values are data, code never hardcodes them.",
  "transport": {"base_url": "https://live.douyin.com", "path": "/{room_web}/", "method": "GET", "placeholders": ["room_web"], "alt_hosts": ["live.douyin.com", "www.live.douyin.com"]},
  "transport_ws": {
    "wss_host": "webcast100-ws-web-lq.douyin.com",
    "path": "/webcast/im/push/v2/",
    "params": {
      "app_name": "douyin_web",
      "version_code": "180800",
      "webcast_sdk_version": "1.0.14-beta.0",
      "update_version_code": "1.0.14-beta.0",
      "compress": "gzip",
      "device_platform": "web",
      "cookie_enabled": "true",
      "screen_width": "1536",
      "screen_height": "864",
      "browser_language": "zh-CN",
      "browser_platform": "Win32",
      "browser_name": "Mozilla",
      "browser_version": "5.0",
      "browser_online": "true",
      "tz_name": "Asia/Shanghai",
      "aid": "6383",
      "live_id": "1",
      "did_rule": "3",
      "endpoint": "live_pc",
      "support_wrds": "1",
      "im_path": "/webcast/im/fetch/",
      "identity": "audience",
      "need_persist_msg_count": "15",
      "sub_room_id": "",
      "sub_channel_id": "",
      "heartbeatDuration": "0"
    },
    "runtime_params": ["user_unique_id", "room_id", "cursor"]
  },
  "binding": {"fields": {"room_id": "$.room_id"}},
  "protocol_methods": {
    "chat": "WebcastChatMessage",
    "gift": "WebcastGiftMessage",
    "like": "WebcastLikeMessage",
    "enter": "WebcastMemberMessage",
    "follow": "WebcastSocialMessage",
    "seq": "WebcastRoomUserSeqMessage",
    "fansclub": "WebcastFansclubMessage",
    "rank": "WebcastRoomRankMessage",
    "room_stat": "WebcastRoomStatsMessage",
    "control": "WebcastControlMessage",
    "emoji": "WebcastEmojiChatMessage",
    "stream": "WebcastRoomStreamAdaptationMessage"
  }
}
