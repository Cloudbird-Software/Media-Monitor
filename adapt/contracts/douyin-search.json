{
  "name": "douyin-search",
  "platform": "douyin",
  "category": "search",
  "version": "1",
  "doc": "general keyword search over videos/image posts (public web API shape)",
  "transport": {
    "base_url": "https://www.douyin.com",
    "path": "/aweme/v1/web/general/search/single/",
    "method": "GET",
    "query": {"device_platform": "webapp", "aid": "6383", "channel": "channel_pc_web", "search_channel": "aweme_general"},
    "placeholders": []
  },
  "signature": {"params": ["a_bogus", "msToken"], "required": ["a_bogus"]},
  "cookie": {"required": ["ttwid"], "source": "browser profile import or env MEDIAMON_DOUYIN_COOKIES"},
  "binding": {
    "items": "$.data",
    "fields": {
      "extra.mix_id": "$.aweme_info.mix_info.mix_id",
      "extra.series_id": "$.aweme_info.series_info.series_id"
    }
  },
  "paging": {"cursor_param": "offset", "count_param": "count", "count_default": 20, "has_more_path": "$.has_more", "next_cursor_path": "$.cursor"}
}
