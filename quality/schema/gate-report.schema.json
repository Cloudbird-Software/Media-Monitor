{
  "type": "object",
  "required": [
    "gate",
    "status",
    "severity",
    "ownerRole",
    "metrics",
    "violations",
    "durationMs"
  ],
  "properties": {
    "gate": { "type": "string" },
    "status": { "enum": ["pass", "fail", "error", "skip"] },
    "severity": { "enum": ["block", "warn"] },
    "ownerRole": {
      "enum": [
        "spec-author",
        "test-author",
        "implementer",
        "refactorer",
        "hardener",
        "adversary",
        "auto",
        "none"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "ratchetKeys": { "type": "array", "items": { "type": "string" } },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "rule", "message"],
        "properties": {
          "file": { "type": "string" },
          "line": { "type": "integer" },
          "symbol": { "type": "string" },
          "rule": { "type": "string" },
          "message": { "type": "string" },
          "fixHint": { "type": "string" },
          "evidence": { "type": "string" }
        }
      }
    },
    "durationMs": { "type": "integer" }
  }
}
